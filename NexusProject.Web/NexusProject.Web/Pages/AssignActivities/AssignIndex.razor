@page "/AssignActivities"
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject AuthenticationStateProvider authenticationStateProvider
@attribute [Authorize(Roles = "Admin, Tutor")]
<PageTitle>Assign Activities</PageTitle>

<h4>ASSIGN ACTIVITIES</h4>

<div class="container">
    <div class="form-section">
        <select @bind="@selectedStudentId">
            <option value="">Select a Student</option>
            @foreach (var user in YoungUsers)
            {
                <option value="@user.Id">@user.FullName</option>
            }
        </select>
        <input placeholder="Activity Name" @bind="@activity.Title" />
        <input placeholder="Percentage" @bind="@activity.Percentage" />

        <button @onclick="UploadActivity">Upload</button>
        <button @onclick="SendActivities">Send</button>
    </div>

    <GenericList MyList="ActivitiesCollection">
        <Body>
            <table class="table">
                <thead>
                    <tr>
                        <th>STUDENT DOCUMENT</th>
                        <th>STUDENT NAME</th>
                        <th>ACTIVITY NAME</th>
                        <th>PERCENTAGE</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var processedActivity in ProcessedActivities)
                    {
                        <tr>
                            <td>@processedActivity.Document</td>
                            <td>@processedActivity.FullName</td>
                            <td>@processedActivity.Title</td>
                            <td>@processedActivity.Percentage %</td>
                        </tr>
                    }
                </tbody>
            </table>
        </Body>
    </GenericList>

    <div class="pagination">
        <Pagination CurrentPage="currentPage"
                    TotalPages="totalPages"
                    SelectedPage="SelectedPage" />
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string Page { get; set; } = "";
    [Parameter]
    [SupplyParameterFromQuery]
    public string Filter { get; set; } = "";

    [CascadingParameter]
    IModalService Modal { get; set; } = default!;

    private List<(string Document, string FullName, string Title, int Percentage)> ProcessedActivities { get; set; } = new();
    private List<User> YoungUsers { get; set; } = new();
    private List<ActivityColection> ActivitiesCollection { get; set; }

    private ActivityColection activiti = new();
    private User Users = new();
    private Activity activity = new();
    private Tutor tutor = new();
    private Young young = new();

    private int selectedStudentId;
    private int currentPage = 1;
    private int totalPages;
    private int loggedInTutorId;


    [CascadingParameter]

    private Task<AuthenticationState> authenticationStateTask { get; set; } = null!;

    private async  Task ParametersSetAsync()

    {

        var authenticationState = await authenticationStateTask;



        var UserId = authenticationState.User.Claims.FirstOrDefault(x => x.Type == "Document"); ;



        if (UserId is not null)

        {
            var Id = UserId.Value;
            var responseHTTP = await repository.GetAsync<Tutor>($"api/Tutors/{Id}");
            tutor = responseHTTP.Response;

            if (responseHTTP.Response != null)
            {
                loggedInTutorId = tutor.Id;
            }
        }        
     


    }
    protected async override Task OnInitializedAsync()
    {

        await ParametersSetAsync();
        await LoadAsync();
    }

    private async Task SelectedPage(int page)
    {
        currentPage = page;
        await LoadAsync(page);
    }

    private async Task LoadAsync(int page = 1)
    {
        if (!string.IsNullOrWhiteSpace(Page))
        {
            page = Convert.ToInt32(Page);
        }

        string url1 = string.IsNullOrEmpty(Filter)
     ? $"api/ActivityCollection?page={page}&tutorId={loggedInTutorId}"
     : $"api/ActivityCollection?page={page}&filter={Filter}&tutorId={loggedInTutorId}";

        string url2 = string.IsNullOrEmpty(Filter)
            ? $"api/ActivityCollection/totalPages?tutorId={loggedInTutorId}"
            : $"api/ActivityCollection/totalPages?filter={Filter}&tutorId={loggedInTutorId}";

        var responseActivities = await repository.GetAsync<List<ActivityColection>>(url1);
        var responseTotalPages = await repository.GetAsync<int>(url2);
        var responseUsers = await repository.GetAsync<List<User>>("api/Users");

        ActivitiesCollection = responseActivities.Response!;
        totalPages = responseTotalPages.Response!;
        YoungUsers = responseUsers.Response!.Where(u => u.UserType.ToString() == "Young").ToList();
        ProcessedActivities.Clear();

        foreach (var activiti in ActivitiesCollection)
        {
            await Student(activiti.Youngid);
            await Activity(activiti.ActivitiesId);

            ProcessedActivities.Add((Users.Document, Users.FullName, activity.Title, activity.Percentage));
        }
    }

    private async Task Activity(int id)
    {
        var responseHTTP = await repository.GetAsync<Activity>($"api/Activitys/{id}");
        activity = responseHTTP.Response;
    }

    private async Task Student(int id)
    {
        var responseHTTP = await repository.GetAsync<Young>($"api/Youngs/id/{id}");
        young = responseHTTP.Response;
        var responseHTTP2 = await repository.GetAsync<User>($"api/Users/{young.UserDocument}");
        Users = responseHTTP2.Response;
    }

    private void UploadActivity()
    {
        // Lógica para cargar la actividad
    }

    private void SendActivities()
    {
        // Lógica para enviar datos al servidor o procesar actividades
    }
}
