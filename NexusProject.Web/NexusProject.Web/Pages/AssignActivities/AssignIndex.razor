@page "/AssignActivities"
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@attribute [Authorize(Roles = "Admin, Tutor")]
<PageTitle>Assign Activities</PageTitle>


<style>
    .container {
        width: 60%;
        margin: auto;
        text-align: center;
        font-family: Arial, sans-serif;
    }

    h4 {
        background-color: #5DACBD;
        color: black;
        text-align: center;
        padding: 15px;
        font-weight: bold;
        margin: 0;
    }

    .form-section {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin: 20px 0;
    }

        .form-section input {
            padding: 8px;
            width: 100px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        .form-section button {
            background-color: #5DACBD;
            color: white;
            padding: 8px 16px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

            .form-section button:hover {
                background-color: #3a91a3;
            }

    .table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

        .table th, .table td {
            border: 1px solid #ddd;
            padding: 10px;
        }

        .table th {
            background-color: #f4f4f4;
            font-weight: bold;
        }

        .table tr:nth-child(even) {
            background-color: #f9f9f9;
        }

    .pagination {
        margin-top: 10px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
    }

        .pagination button {
            background-color: #5DACBD;
            color: white;
            padding: 5px 10px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

            .pagination button:hover {
                background-color: #3a91a3;
            }

        .pagination span {
            font-size: 16px;
        }
</style>

<h4>ASSIGN ACTIVITIES</h4>

<div class="container">
    <div class="form-section">       
        <input placeholder="Student Name" @bind="@newActivity.StudentName" />
        <input placeholder="Activity Name" @bind="@newActivity.ActivityName" />
        <input placeholder="Percentage" @bind="@newActivity.Percentage" />

        <button @onclick="UploadActivity">Upload</button>
        <button @onclick="SendActivities">Send</button>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>ID STUDENT</th>
                <th>STUDENT NAME</th>
                <th>ACTIVITY NAME</th>
                <th>PERCENTAGE</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var activity in activities)
            {
                <tr>
                    <td>@activity.StudentId</td>
                    <td>@activity.StudentName</td>
                    <td>@activity.ActivityName</td>
                    <td>@activity.Percentage%</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination">
        <Pagination CurrentPage="currentPage"
                    TotalPages="totalPages"
                    SelectedPage="SelectedPage" />
    </div>
</div>

@code {


    [Parameter]
    [SupplyParameterFromQuery]
    public string Page { get; set; } = "";
    [Parameter]
    [SupplyParameterFromQuery]
    public string Filter { get; set; } = "";

    [CascadingParameter]
    IModalService Modal { get; set; } = default!;

    private int currentPage = 1;
    private int totalPages;




    private async Task SelectedPage(int page)
    {
        currentPage = page;
        await LoadAsync(page);
    }






    private async Task LoadAsync(int page = 1)
    {

        if (!string.IsNullOrWhiteSpace(Page))
        {
            page = Convert.ToInt32(Page);
        }
        string url1 = string.Empty;
        string url2 = string.Empty;
        if (string.IsNullOrEmpty(Filter))
        {
            url1 = $"api/Users?page={page}";
            url2 = $"api/Users/totalPages";
        }
        else
        {
            url1 = $"api/Users?page={page}&filter={Filter}";
            url2 = $"api/Users/totalPages?filter={Filter}";
        }

        var responseHppt = await repository.GetAsync<List<User>>(url1);
        var responseHppt2 = await repository.GetAsync<int>(url2);      
        totalPages = responseHppt2.Response!;




    }


    private List<Activity> activities = new List<Activity>
    {
        new Activity { StudentId = 1, StudentName = "Juanito", ActivityName = "Sport", Percentage = 20 },
        new Activity { StudentId = 2, StudentName = "Edwin Ramirez", ActivityName = "Meditation", Percentage = 20 },
        new Activity { StudentId = 3, StudentName = "Valentina", ActivityName = "Broking hearts", Percentage = 100 }
    };

    private Activity newActivity = new Activity();

    private void UploadActivity()
    {
        activities.Add(new Activity
            {
                StudentId = newActivity.StudentId,
                StudentName = newActivity.StudentName,
                ActivityName = newActivity.ActivityName,
                Percentage = newActivity.Percentage
            });
        newActivity = new Activity();
    }

    private void SendActivities()
    {
        // Lógica para enviar datos al servidor o procesar actividades
    }

    private void PreviousPage()
    {
        if (currentPage > 1) currentPage--;
    }

    private void NextPage()
    {
        currentPage++;
    }

    public class Activity
    {
        public int StudentId { get; set; }
        public string StudentName { get; set; }
        public string ActivityName { get; set; }
        public int Percentage { get; set; }
    }
}