@page "/AssignActivities"
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject AuthenticationStateProvider authenticationStateProvider
@attribute [Authorize(Roles = "Tutor")]
<PageTitle>Assign Activities</PageTitle>

<h4>ASSIGN ACTIVITIES</h4>

<div class="containergrade">
<EditForm Model="activitycollection" >

        <DataAnnotationsValidator />


        <div class="form-section row">
            <div class="col-md-2 mt-2">
                <label for="studentSelect">Select a Student</label>
                <select id="studentSelect" class="form-control" @bind="@selectedStudentId">
                    <option value="0">Select a Student</option>
                    @foreach (var user in YoungUsers)
                    {
                        <option value="@user.Document">@user.FullName</option>
                    }
                </select>
            </div>

            <div class="col-md-2 mt-2">
                <label for="activityTitle">Activity Name</label>
                <InputText class="form-control" id="activityTitle" placeholder="Activity Name" @bind-Value="@activity2.Title" />
                <ValidationMessage For="@(() => activity2.Title)" />
            </div>

            <div class="col-md-1 mt-2">
                <label for="activityPercentage">Activity %</label>
                <InputNumber class="form-control" id="activityPercentage" placeholder="Activity Percentage" @bind-Value="@activity2.Percentage" />
                <ValidationMessage For="@(() => activity2.Percentage)" />
            </div>

            <div class="col-md-2 mt-2">
                <label for="activityDate">Maximum Date</label>
                <InputDate class="form-control" id="activityDate" placeholder="Activity Last Date To Send" @bind-Value="@activity2.DateandTime" />
                <ValidationMessage For="@(() => activity2.DateandTime)" />
            </div>

            <div class="col-md-2 mt-2">
                <label for="activityDescription">Activity Description</label>
                <InputText class="form-control" id="activityDescription" placeholder="Activity Description" @bind-Value="@activity2.Description"  />
                <ValidationMessage For="@(() => activity2.Description)" />
            </div>

            <div class="col-md-1 mt-4">
                <label for="fileUpload" class="btn btn-primary custom-file-button">
                    Upload File
                </label>
                <InputFile id="fileUpload" OnChange="OnChange" class="d-none" accept=".pdf, .docx, .xlsx, .doc, .xls, .jpeg, .png, .jpg" />
            </div>

            <div class="col-md-2 mt-4 ">
                <button class="btn btn-primary custom-file-button" @onclick="SendActivities">Assign Activity</button>
            </div>
        </div>
</EditForm>

    <GenericList MyList="ActivitiesCollection">




        <Body>

            <div class="col-md-12 mt-5">
            </div>
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>ACTIVITY ID</th>
                        <th>STUDENT DOCUMENT</th>
                        <th>STUDENT NAME</th>
                        <th>ACTIVITY NAME</th>
                        <th>ACTIVITY DESCRIPTION</th>
                        <th>ACTIVITY DUE DATE</th>
                        <th>ACTIVITY FILE</th>
                        <th>PERCENTAGE</th>
                        <th>DELIVERED TASK</th>
                        <th>DELIVERED TIME</th>
                        <th>REOPEN</th>


                    </tr>
                </thead>
                <tbody>
                    @foreach (var processedActivity in ProcessedActivities)
                    {
                        <tr>
                            <td>@processedActivity.id</td>
                            <td>@processedActivity.Document</td>
                            <td>@processedActivity.FullName</td>
                            <td>@processedActivity.Title</td>
                            <td>@processedActivity.Description</td>
                            <td>@processedActivity.DateandTime.ToString("yyyy-MM-dd")</td>

                            <td>
                                @if (!string.IsNullOrEmpty(processedActivity.File))
                                {
                                    <a href="@processedActivity.File" target="_blank" class="btn btn-primary custom-file-button">
                                        Download
                                    </a>
                                }
                                else
                                {
                                    <span>No file uploaded</span>
                                }
                            </td>
                            <td>@processedActivity.Percentage %</td>
                            <td>
                                @if (!string.IsNullOrEmpty(processedActivity.File2))
                                {
                                    <a href="@processedActivity.File2" target="_blank" class="btn btn-primary custom-file-button">
                                        Download
                                    </a>
                                }
                                else
                                {
                                    <span>No file uploaded</span>
                                }
                            </td>


                            <td>
                                @if (@processedActivity.SenDate.ToString("yyyy-MM-dd--HH--mm").Equals("0001-01-01--00--00"))
                                {
                                    <span>Not Delivered</span>
                                }
                                else
                                {
                                    @processedActivity.SenDate.ToString("yyyy-MM-dd--HH--mm")
                                }
                            </td>

                            <td>

                                @if (processedActivity.DateandTime < DateTime.Now)
                                {

                                <td><button class="btn btn-primary custom-file-button" @onclick="() => ShowModal(processedActivity.id)">ReOpen</button></td>
                                }
                                else if (processedActivity.File2 != null)
                                {
                                <td><button class="btn btn-primary custom-file-button" @onclick="() => ShowModal(processedActivity.id)">ReOpen</button></td>
                                }
                                else
                                {
                                    <span>THE TASK IS OPENED</span>
                                }
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </Body>
    </GenericList>

    <div class="pagination">
        <Pagination CurrentPage="currentPage"
                    TotalPages="totalPages"
                    SelectedPage="SelectedPage" />
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string Page { get; set; } = "";
    [Parameter]
    [SupplyParameterFromQuery]
    public string Filter { get; set; } = "";

    [CascadingParameter]
    IModalService Modal { get; set; } = default!;

    private List<(int id, string Document, string FullName, string Title, string Description, DateTime DateandTime, string File, int Percentage, string File2, DateTime SenDate )> ProcessedActivities { get; set; } = new();
    private List<User> YoungUsers { get; set; } = new();
    private List<ActivityColection> ActivitiesCollection { get; set; }

    private ActivityColection activitycollection = new();
    private User Users = new();
    private Activity activity = new();
    private Activity activity2 = new();
    private Follow follow = new();
    private Tutor tutor = new();
    private Young young = new();
    private string selectedStudentId;
    private int currentPage = 1;
    private int totalPages;
    private int loggedInTutorId;



    [Parameter] public string? FileURL { get; set; }

    [Parameter] public EventCallback<string> FileSelected { get; set; }

    private async Task ShowModal(int id)
    {
        IModalReference modalReference;
        modalReference = Modal.Show<ReOpen>("REOPEN ACTIVITY", new ModalParameters().Add("ActivityId", id));
        var result = await modalReference.Result;
        if (result.Confirmed)
        {
            await LoadAsync();
        }
    }

    private string? FileBase64;

    private async Task OnChange(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                // Crear el contenido multipart
                var content = new MultipartFormDataContent();
                var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 10485760)); 
                content.Add(fileContent, "file", file.Name);

           
                var response = await repository.UploadFile(content, "api/file/upload");

                if (!response.Error)
                {
                  
                    activity2.FileTask = response.Response;
                    FileURL = response.Response;
                    await FileSelected.InvokeAsync(response.Response);
                    StateHasChanged();
                }
                else
                {
                    var errorMessage = await response.GetErrorMessageAsync();
                    await sweetAlertService.FireAsync("Error", errorMessage, SweetAlertIcon.Error);
                }
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error uploading file: {ex.Message}", SweetAlertIcon.Error);
        }
    }


    [CascadingParameter]

    private Task<AuthenticationState> authenticationStateTask { get; set; } = null!;

    private async  Task ParametersSetAsync()
    {
        var authenticationState = await authenticationStateTask;



        var UserId = authenticationState.User.Claims.FirstOrDefault(x => x.Type == "Document"); 



        if (UserId is not null)

        {
            var Id = UserId.Value;
            var responseHTTP = await repository.GetAsync<Tutor>($"api/Tutors/{Id}");
            tutor = responseHTTP.Response;

            if (responseHTTP.Response != null)
            {
                loggedInTutorId = tutor.Id;
            }
        }        



    }
    protected async override Task OnInitializedAsync()
    {

        activity2.DateandTime = DateTime.Today;
        await ParametersSetAsync();
        await LoadAsync();
    }

    private async Task SelectedPage(int page)
    {
        currentPage = page;
        await LoadAsync(page);
    }

    private async Task LoadAsync(int page = 1)
    {
        if (!string.IsNullOrWhiteSpace(Page))
        {
            page = Convert.ToInt32(Page);
        }

        string url1 = string.IsNullOrEmpty(Filter)
     ? $"api/ActivityCollection?page={page}&tutorId={loggedInTutorId}"
     : $"api/ActivityCollection?page={page}&filter={Filter}&tutorId={loggedInTutorId}";

        string url2 = string.IsNullOrEmpty(Filter)
            ? $"api/ActivityCollection/totalPages?tutorId={loggedInTutorId}"
            : $"api/ActivityCollection/totalPages?filter={Filter}&tutorId={loggedInTutorId}";

        var responseActivities = await repository.GetAsync<List<ActivityColection>>(url1);
        var responseTotalPages = await repository.GetAsync<int>(url2);
        var responseUsers = await repository.GetAsync<List<User>>("api/Users");

        ActivitiesCollection = responseActivities.Response!;
        totalPages = responseTotalPages.Response!;
        YoungUsers = responseUsers.Response!.Where(u => u.UserType.ToString() == "Young").ToList();
        ProcessedActivities.Clear();

        foreach (var activitycollection in ActivitiesCollection)
        {
            await Student(activitycollection.Youngid);
            await Activity(activitycollection.ActivitiesId);

            ProcessedActivities.Add((activity.Id, Users.Document, Users.FullName, activity.Title, activity.Description, activity.DateandTime, activity.FileTask, activity.Percentage,
            activity.SendTask, activity.SendTime));
        }
    }

    private async Task Activity(int id)
    {
        var responseHTTP = await repository.GetAsync<Activity>($"api/Activitys/{id}");
        activity = responseHTTP.Response;
    }

    private async Task Student(int id)
    {
        var responseHTTP = await repository.GetAsync<Young>($"api/Youngs/id/{id}");
        young = responseHTTP.Response;
        var responseHTTP2 = await repository.GetAsync<User>($"api/Users/{young.UserDocument}");
        Users = responseHTTP2.Response;
    }




    private async Task SendActivities()
    {
        if (selectedStudentId == "0" || string.IsNullOrEmpty(selectedStudentId))
        {
            var message = "You must choose a Student";
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return; 
        }

        try
        {

            var responseHTTP3 = await repository.GetAsync<Young>($"api/Youngs/{selectedStudentId}");
            young = responseHTTP3.Response;

            var responseHttp = await repository.PostAsync<Activity, Activity>("/api/Activitys", activity2);
            var createdActivity = responseHttp.Response;
            follow.Remarks = "GRADE NOT ASSIGNED";
            follow.punctuation = 0;
            var responseHttp3 = await repository.PostAsync<Follow, Follow>("/api/Follows", follow);
            var createdFollow = responseHttp3.Response;

            activitycollection.ActivitiesId = createdActivity.Id;
            activitycollection.Youngid = young.Id;
            activitycollection.TutorsId = loggedInTutorId;
            activitycollection.FollowsId = createdFollow.Id;

            var responseHttp2 = await repository.PostAsync("/api/ActivityCollection", activitycollection);

            if (responseHttp.Error)
            {
                var message = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                return;
            }
            else if (responseHttp2.Error)
            {
                var message = await responseHttp2.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                return;
            }

            await sweetAlertService.FireAsync("Success", "Your activity has been successfully created.", SweetAlertIcon.Info);
            navigationManager.NavigateTo("/AssignActivities", true);

        }
        catch (Exception ex)
        {
        
            await sweetAlertService.FireAsync("Error", $"An error occurred: {ex.Message}", SweetAlertIcon.Error);
        }
    }
}