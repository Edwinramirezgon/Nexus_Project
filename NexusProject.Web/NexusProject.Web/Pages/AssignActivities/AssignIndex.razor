@page "/AssignActivities"
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject AuthenticationStateProvider authenticationStateProvider
@attribute [Authorize(Roles = "Admin, Tutor")]
<PageTitle>Assign Activities</PageTitle>

<h4>ASSIGN ACTIVITIES</h4>

<div class="container">
<EditForm Model="activiti" >

        <DataAnnotationsValidator />


        <div class="form-section">

            

                <select  @bind="@selectedStudentId">
                    <option value="0">Select a Student</option>
                    @foreach (var user in YoungUsers)
                    {
                        <option value="@user.Document">@user.FullName</option>
                    }
                </select>
          

            
                    <div>
                <label for="floatingInput3">Activity Name</label>

                <InputText class="form-control col-1" id="floatingInput" placeholder="Activity Name" @bind-Value="@activity2.Title" />
                <ValidationMessage For="@(() => activity2.Title)" />
            </div>
            <div>
            <label for="floatingInput2">Activity %</label>
            <InputNumber class="form-control col-1" id="floatingInput2" placeholder="Activity Percentage" @bind-Value="@activity2.Percentage" />

            <ValidationMessage For="@(() => activity2.Percentage)" />

            </div>


               

            <div>
                <label for="floatingInput4">Maximum Date</label>
            <InputDate class="form-control" id="floatingInput4" placeholder="Activity Last Date To Send" @bind-Value="@activity2.DateandTime" />

            <ValidationMessage For="@(() => activity2.DateandTime)" />
            </div>
            <div>
                <label for="floatingInput3">Activity Description</label>

                <InputText class="form-control col-3" id="floatingInput3" placeholder="Activity Description&nbsp;&nbsp; &nbsp;&nbsp; &nbsp;" @bind-Value="@activity2.Description" />

                <ValidationMessage For="@(() => activity2.Description)" />
            </div>

            
        <button @onclick="UploadActivity">Upload</button>
               
        <button @onclick="SendActivities">Send</button>

    
        </div>
</EditForm>

    <GenericList MyList="ActivitiesCollection">
        <Body>
            <table class="table">
                <thead>
                    <tr>
                        <th>STUDENT DOCUMENT</th>
                        <th>STUDENT NAME</th>
                        <th>ACTIVITY NAME</th>
                        <th>ACTIVITY DESCRIPTION</th>
                        <th>ACTIVITY FILE</th>
                        <th>PERCENTAGE</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var processedActivity in ProcessedActivities)
                    {
                        <tr>
                            <td>@processedActivity.Document</td>
                            <td>@processedActivity.FullName</td>
                            <td>@processedActivity.Title</td>
                            <td>@processedActivity.Description</td>
                            <td>@processedActivity.File</td>
                            <td>@processedActivity.Percentage %</td>
                        </tr>
                    }
                </tbody>
            </table>
        </Body>
    </GenericList>

    <div class="pagination">
        <Pagination CurrentPage="currentPage"
                    TotalPages="totalPages"
                    SelectedPage="SelectedPage" />
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string Page { get; set; } = "";
    [Parameter]
    [SupplyParameterFromQuery]
    public string Filter { get; set; } = "";

    [CascadingParameter]
    IModalService Modal { get; set; } = default!;

    private List<(string Document, string FullName, string Title, string Description, String File, int Percentage)> ProcessedActivities { get; set; } = new();
    private List<User> YoungUsers { get; set; } = new();
    private List<ActivityColection> ActivitiesCollection { get; set; }

    private ActivityColection activiti = new();
    private User Users = new();
    private Activity activity = new();
    private Activity activity2 = new();
    private Tutor tutor = new();
    private Young young = new();
    private string selectedStudentId;
    private int currentPage = 1;
    private int totalPages;
    private int loggedInTutorId;


    [CascadingParameter]

    private Task<AuthenticationState> authenticationStateTask { get; set; } = null!;

    private async  Task ParametersSetAsync()

    {

        var authenticationState = await authenticationStateTask;



        var UserId = authenticationState.User.Claims.FirstOrDefault(x => x.Type == "Document"); ;



        if (UserId is not null)

        {
            var Id = UserId.Value;
            var responseHTTP = await repository.GetAsync<Tutor>($"api/Tutors/{Id}");
            tutor = responseHTTP.Response;

            if (responseHTTP.Response != null)
            {
                loggedInTutorId = tutor.Id;
            }
        }        



    }
    protected async override Task OnInitializedAsync()
    {

        await ParametersSetAsync();
        await LoadAsync();
    }

    private async Task SelectedPage(int page)
    {
        currentPage = page;
        await LoadAsync(page);
    }

    private async Task LoadAsync(int page = 1)
    {
        if (!string.IsNullOrWhiteSpace(Page))
        {
            page = Convert.ToInt32(Page);
        }

        string url1 = string.IsNullOrEmpty(Filter)
     ? $"api/ActivityCollection?page={page}&tutorId={loggedInTutorId}"
     : $"api/ActivityCollection?page={page}&filter={Filter}&tutorId={loggedInTutorId}";

        string url2 = string.IsNullOrEmpty(Filter)
            ? $"api/ActivityCollection/totalPages?tutorId={loggedInTutorId}"
            : $"api/ActivityCollection/totalPages?filter={Filter}&tutorId={loggedInTutorId}";

        var responseActivities = await repository.GetAsync<List<ActivityColection>>(url1);
        var responseTotalPages = await repository.GetAsync<int>(url2);
        var responseUsers = await repository.GetAsync<List<User>>("api/Users");

        ActivitiesCollection = responseActivities.Response!;
        totalPages = responseTotalPages.Response!;
        YoungUsers = responseUsers.Response!.Where(u => u.UserType.ToString() == "Young").ToList();
        ProcessedActivities.Clear();

        foreach (var activiti in ActivitiesCollection)
        {
            await Student(activiti.Youngid);
            await Activity(activiti.ActivitiesId);

            ProcessedActivities.Add((Users.Document, Users.FullName, activity.Title, activity.Description, activity.FileTask, activity.Percentage));
        }
    }

    private async Task Activity(int id)
    {
        var responseHTTP = await repository.GetAsync<Activity>($"api/Activitys/{id}");
        activity = responseHTTP.Response;
    }

    private async Task Student(int id)
    {
        var responseHTTP = await repository.GetAsync<Young>($"api/Youngs/id/{id}");
        young = responseHTTP.Response;
        var responseHTTP2 = await repository.GetAsync<User>($"api/Users/{young.UserDocument}");
        Users = responseHTTP2.Response;
    }

    private void UploadActivity()
    {

    }

    private async Task SendActivities()
    {
        if (selectedStudentId == "0" || string.IsNullOrEmpty(selectedStudentId))
        {
            var message = "You must choose a Student";
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;  // Detener el proceso si no se ha seleccionado un estudiante
        }

        try
        {
            // Realizar la solicitud solo si se ha seleccionado un estudiante
            var responseHTTP3 = await repository.GetAsync<Young>($"api/Youngs/{selectedStudentId}");
            young = responseHTTP3.Response;

            var responseHttp = await repository.PostAsync<Activity, Activity>("/api/Activitys", activity2);
            var createdActivity = responseHttp.Response;

            activiti.ActivitiesId = createdActivity.Id;
            activiti.Youngid = young.Id;
            activiti.TutorsId = loggedInTutorId;

            var responseHttp2 = await repository.PostAsync("/api/ActivityCollection", activiti);

            if (responseHttp.Error)
            {
                var message = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                return;
            }
            else if (responseHttp2.Error)
            {
                var message = await responseHttp2.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                return;
            }

            await sweetAlertService.FireAsync("Success", "Your activity has been successfully created.", SweetAlertIcon.Info);
            navigationManager.NavigateTo("/AssignActivities", true);

        }
        catch (Exception ex)
        {
            // Manejar cualquier excepción que pueda ocurrir durante la ejecución
            await sweetAlertService.FireAsync("Error", $"An error occurred: {ex.Message}", SweetAlertIcon.Error);
        }
    }}