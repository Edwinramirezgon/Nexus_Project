@page "/Grades"
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject AuthenticationStateProvider authenticationStateProvider
@attribute [Authorize(Roles = "Young")]


<style>
    .grade-input {
        width: 70px;
        text-align: center;
    }

    .grade-column {
        width: 90px;
        text-align: center;
    }
</style>

<PageTitle>Assign Activities</PageTitle>


<h4>ASSIGN GRADES TO YOUR STUDENTS</h4>

<div class="containergrade">
    <GenericList MyList="ActivitiesCollection">
        <Body>
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>ACTIVITY ID</th>                    
                        <th>TUTOR NAME</th>
                        <th>ACTIVITY NAME</th>
                        <th>ACTIVITY DESCRIPTION</th>
                        <th>ACTIVITY DUE DATE</th>
                        <th>PERCENTAGE</th>
                        <th class="grade-column">GRADE</th>
                        <th>REMARKS</th>
                        <th>DELIVERED TASK</th>
                        <th>DELIVERED TIME</th>                      
                    </tr>
                </thead>
                <tbody>
                    @foreach (var processedActivity in ProcessedActivities)
                    {
                        <tr>
                            <td>@processedActivity.activityId</td>               
                            <td>@processedActivity.FullName</td>
                            <td>
                                @if (!string.IsNullOrEmpty(processedActivity.File))
                                {
                                    <a href="@processedActivity.File" target="_blank" class="btn btn-link">
                                        @processedActivity.Title
                                    </a>
                                }
                                else
                                {
                                    <span>@processedActivity.Title</span>
                                }
                            </td>
                            <td>@processedActivity.Description</td>
                            <td>@processedActivity.Duedate.ToString("yyyy-MM-dd")</td>
                            <td>@processedActivity.Percentage %</td>
                            <td class="grade-column">@processedActivity.Grade</td>
                            <td>@processedActivity.Remarks</td>
                            <td>
                                @if (processedActivity.SendTask == null)
                                {
                                    <button class="btn btn-secondary custom-file-button" disabled>Not Delivered</button>
                                }
                                else if (processedActivity.SendTask != null)
                                {
                                    <a href="@processedActivity.SendTask" target="_blank" class="btn btn-primary custom-file-button">
                                        Delivered
                                    </a>
                                }
                            </td>
                            <td>
                                @if (@processedActivity.SendDate.ToString("yyyy-MM-dd--HH--mm").Equals("0001-01-01--00--00"))
                                {
                                    <span>Not Delivered</span>
                                }
                                else
                                {
                                    @processedActivity.SendDate.ToString("yyyy-MM-dd--HH--mm")
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </Body>
    </GenericList>

    <div class="pagination">
        <Pagination CurrentPage="currentPage"
                    TotalPages="totalPages"
                    SelectedPage="SelectedPage" />
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string Page { get; set; } = "";

    [Parameter]
    [SupplyParameterFromQuery]
    public string Filter { get; set; } = "";

    private List<ActivityData> ProcessedActivities { get; set; } = new();
    private List<ActivityColection> ActivitiesCollection { get; set; }
    private ActivityColection activitycollection = new();
    private User Users = new();
    private Activity activity = new();
    private Tutor tutor = new();
    private Young young = new();
    private Follow follow = new();
    private string selectedTutorId;
    private string Sendtask;
    private int currentPage = 1;
    private int totalPages;
    private int loggedInYoungId;


    private class ActivityData
    {
        public int activityId { get; set; }
        public string Document { get; set; }
        public string FullName { get; set; }
        public string File { get; set; }
        public string Title { get; set; }
        public string Description { get; set; }
        public DateTime Duedate { get; set; }
        public int Percentage { get; set; }
        public double Grade { get; set; }
        public string Remarks { get; set; }
        public string SendTask { get; set; }
        public DateTime SendDate { get; set; }
        public int Followid { get; set; }
    }

    protected async override Task OnInitializedAsync()
    {
        await ParametersSetAsync();
        await LoadAsync();
    }

    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; } = null!;

    private async Task ParametersSetAsync()
    {
        var authenticationState = await authenticationStateTask;
        var UserId = authenticationState.User.Claims.FirstOrDefault(x => x.Type == "Document");
        if (UserId is not null)
        {
            var Id = UserId.Value;
            var responseHTTP = await repository.GetAsync<Young>($"api/Youngs/{Id}");
            young = responseHTTP.Response;

            if (responseHTTP.Response != null)
            {
               loggedInYoungId = young.Id;
            }
        }
    }

    private async Task LoadAsync(int page = 1)
    {
        if (!string.IsNullOrWhiteSpace(Page))
        {
            page = Convert.ToInt32(Page);
        }

        string url1 = string.IsNullOrEmpty(Filter)
            ? $"api/ActivityCollection2?page={page}&Youngid={loggedInYoungId}"
            : $"api/ActivityCollection2?page={page}&filter={Filter}&Youngid={loggedInYoungId}";

        string url2 = string.IsNullOrEmpty(Filter)
            ? $"api/ActivityCollection2/totalPages?Youngid={loggedInYoungId}"
            : $"api/ActivityCollection2/totalPages?filter={Filter}&Youngid={loggedInYoungId}";

        var responseActivities = await repository.GetAsync<List<ActivityColection>>(url1);
        var responseTotalPages = await repository.GetAsync<int>(url2);
        var responseUsers = await repository.GetAsync<List<User>>("api/Users");

        ActivitiesCollection = responseActivities.Response!;
        totalPages = responseTotalPages.Response!;
        ProcessedActivities.Clear();

        foreach (var activitycollection in ActivitiesCollection)
        {
            await Search(activitycollection.TutorsId, activitycollection.ActivitiesId, activitycollection.FollowsId);
            ProcessedActivities.Add(new ActivityData
                {
                    activityId = activity.Id,
                    Document = Users.Document,
                    FullName = Users.FullName,
                    File = activity.FileTask,
                    Title = activity.Title,
                    Description = activity.Description,
                    Duedate = activity.DateandTime,
                    Percentage = activity.Percentage,
                    Grade = follow.punctuation,
                    Remarks = follow.Remarks,
                    SendTask = activity.SendTask,
                    SendDate = activity.SendTime,
                    Followid = follow.Id
                });
        }
    }

    private async Task Search(int tutorid, int activityid, int followid)
    {
        var responseHTTP = await repository.GetAsync<Tutor>($"api/Tutors/id/{tutorid}");
        tutor = responseHTTP.Response;
        var responseHTTP2 = await repository.GetAsync<User>($"api/Users/{tutor.UserDocument}");
        Users = responseHTTP2.Response;
        var responseHTTP3 = await repository.GetAsync<Activity>($"api/Activitys/{activityid}");
        activity = responseHTTP3.Response;
        var responseHTTP4 = await repository.GetAsync<Follow>($"api/Follows/{followid}");
        follow = responseHTTP4.Response;
    }


    private async Task SelectedPage(int page)
    {
        currentPage = page;
        await LoadAsync(page);
    }
}