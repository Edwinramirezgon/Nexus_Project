@page "/"

<PageTitle>Nexus Project</PageTitle>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexus Project</title>
    <link rel="stylesheet" href="styles.css"> 
</head>
<body>

    <!-- Sección de imagen de encabezado -->
    <div class="header-image3">
        <img src="images/home.png" alt="Group of people" class="header-img3">
    </div>

    <!-- Sección de tarjetas -->
    <div class="cards-container3">
        <div class="card3">
            <img src="images/Professional.png" alt="Professional Support" class="card-img3">
            <div class="card-overlay3">
                <span>PROFESSIONAL SUPPORT</span>
            </div>
        </div>
        <div class="card3">
            <img src="images/Emotional.png" alt="Emotional Health" class="card-img3">
            <div class="card-overlay3">
                <span>EMOTIONAL HEALTH</span>
            </div>
        </div>
        <div class="card3">
            <img src="images/Activities.png" alt="Activities" class="card-img3">
            <div class="card-overlay3">
                <span>ACTIVITIES</span>
            </div>
        </div>
    </div>

    <section class="mission-section">
        <div class="mission-background">
            <img src="images/Mission.png" alt="Mission Background" />
        </div>
        <div class="mission-content">
            <h2>MISSION</h2>
            <p>"Our mission is to provide young people with the necessary tools to build a future full of opportunities. Through personalized tutoring, mentorship programs, and comprehensive support, we aim to strengthen their self-esteem, academic and emotional skills, and help them break the cycle of vulnerability."</p>
        </div>
    </section>

</body>
</html>




     