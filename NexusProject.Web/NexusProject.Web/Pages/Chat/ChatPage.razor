@page "/chat"
@inject IRepository repository
@using Microsoft.Extensions.Configuration
@using System.Threading
@inject IConfiguration Configuration
@inject AuthenticationStateProvider authenticationStateProvider
@attribute [Authorize(Roles = "Tutor, Young, Admin")]

<div class="chat-app">
    <ContactList ContactSelected="OnContactSelected" />
    @if (SelectedContact != null)
    {
        <ChatWindow Contact="SelectedContact"
                    Messages="messages"
                    CurrentChat="currentChat"
                  />
    }
    else
    {
        <div class="no-chat-selected">
            <p>Select a contact to start chatting</p>
        </div>
    }
</div>

@code {
    private User SelectedContact;
    private List<Message> messages = new List<Message>();
    private Chat currentChat;
    private string CurrentUserId;
    private List<Chat> _chats = new List<Chat>();
    private Timer _timer;
    private DateTime? LastMessageTime; // Guarda el tiempo del último mensaje recibido

    protected async override Task OnInitializedAsync()
    {
        await ParametersSetAsync();
        StartPolling();
    }

    private DateTime? lastMessageDate;

    private void StartPolling()
    {
        _timer = new Timer(async _ =>
        {
            if (SelectedContact != null)
            {
                var newMessages = await GetConversationAsync(currentChat.ChatId, lastMessageDate);

                if (newMessages.Any())
                {
                
                    messages.AddRange(newMessages);
                    lastMessageDate = newMessages.Last().DateandTime;
                    InvokeAsync(StateHasChanged);
                }
            }
        }, null, TimeSpan.Zero, TimeSpan.FromMilliseconds(500));
    }

    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; } = null!;

    private async Task ParametersSetAsync()
    {
        var authenticationState = await authenticationStateTask;
        var UserId = authenticationState.User.Claims.FirstOrDefault(x => x.Type == "Document");

        if (UserId is not null)
        {
            CurrentUserId = UserId.Value;
        }
    }

    private async Task OnContactSelected(User contact)
    {
        SelectedContact = contact;
        currentChat = await GetOrCreateChatAsync(CurrentUserId, contact.Document);

        // Cargar todos los mensajes la primera vez que se selecciona el contacto
        messages = await GetConversationAsync(currentChat.ChatId);

        // Registrar la fecha del último mensaje
        if (messages.Any())
        {
            lastMessageDate = messages.Last().DateandTime;
        }

        StateHasChanged();
    }

    public async Task<Chat> GetOrCreateChatAsync(string user1Id, string user2Id)
    {
        var responseHppt = await repository.GetAsync<List<Chat>>("api/Chats");
        _chats = responseHppt.Response!;
        var sortedIds = new[] { user1Id, user2Id }.OrderBy(id => id).ToList();

        var existingChat = _chats.FirstOrDefault(c =>
            (c.User1Id == sortedIds[0] && c.User2Id == sortedIds[1]));

        if (existingChat != null)
            return existingChat;

        var newChat = new Chat
            {
                ChatId = Guid.NewGuid().ToString(),
                User1Id = sortedIds[0],
                User2Id = sortedIds[1],             
            };

        var responseHttp = await repository.PostAsync<Chat, Chat>("/api/Chats", newChat);
        return newChat;
    }

    public async Task<List<Message>> GetConversationAsync(string chatId, DateTime? afterDate = null)
    {
        var url = $"api/Messages?chatId={chatId}";

        if (afterDate.HasValue)
        {
            url += $"&afterDate={afterDate.Value:o}"; // Usa formato ISO para la fecha
        }

        var responseHttp = await repository.GetAsync<List<Message>>(url);
        return responseHttp.Response ?? new List<Message>();
    }
}