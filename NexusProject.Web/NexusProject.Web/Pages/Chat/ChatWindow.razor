@inject IRepository repository
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@inject AuthenticationStateProvider authenticationStateProvider
@attribute [Authorize(Roles = "Tutor, Young, Admin")]

<div class="chat-window">
    <div class="chat-header">
        <h3>@Contact.FullName</h3>
    </div>
    <div class="messages">
        @foreach (var message in Messages)
        {
            <div class="message @(message.SenderId == CurrentUserId ? "user-message" : "contact-message")">
                <p>@message.Content</p>
                <span class="timestamp">@message.DateandTime.ToString("g")</span>
            </div>
        }
    </div>
    <div class="message-input">
        <input type="text"
               @bind="NewMessageContent"
               @bind:event="oninput"
               @onkeypress="HandleKeyPress"
               placeholder="Type your message..." />
        <button @onclick="SendMessage">Send</button>
    </div>
</div>

@code {
    [Parameter] public User Contact { get; set; }
    [Parameter] public List<Message> Messages { get; set; } = new List<Message>();
    [Parameter] public Chat CurrentChat { get; set; }
    private List<Chat> _chats = new List<Chat>();
    private List<Message> _messages = new List<Message>();

    private string NewMessageContent { get; set; }
    private string CurrentUserId;

    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; } = null!;

    protected async override Task OnInitializedAsync()
    {
        await ParametersSetAsync();

    }

    private async Task ParametersSetAsync()
    {
        var authenticationState = await authenticationStateTask;

        var UserId = authenticationState.User.Claims.FirstOrDefault(x => x.Type == "Document");

        if (UserId is not null)

        {
            CurrentUserId = UserId.Value;

        }

    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(NewMessageContent))
        {
            var message = new Message
                {
                    ChatId = CurrentChat.ChatId,
                    SenderId = CurrentUserId,
                    ReceiverId = Contact.Document,
                    Content = NewMessageContent,
                    DateandTime = DateTime.UtcNow
                };

            await SendMessageAsync(message);
            Messages.Add(message);
            var responseHttp = await repository.PostAsync<Message>("/api/Messages", message);
            StateHasChanged();
        }
    }

    public async Task SendMessageAsync(Message message)
    {
        var responseHppt = await repository.GetAsync<List<Chat>>("api/Chats");
        _chats = responseHppt.Response!;
        var chat = _chats.FirstOrDefault(c => c.ChatId == message.ChatId);
        if (chat != null)
        {
            var responseHttp = await repository.PostAsync<Message>("/api/Messages", message);         

        
            chat.MessageHistory.Add(message.Content);
            chat.LastMessage = message.Content;
            chat.LastMessageTime = message.DateandTime;

            await Task.CompletedTask;
        }
    }
}